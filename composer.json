{
    "name": "mikepagedev/portfolio-frontend",
    "description": "Public portfolio and case-study pages for Laravel, with or without Filament.",
    "keywords": [
        "laravel",
        "filament",
        "portfolio",
        "case-studies",
        "blade"
    ],
    "homepage": "https://github.com/MikePageDev/portfolio-frontend",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mike Page",
            "homepage": "https://mikepage.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/MikePageDev/portfolio-frontend/issues",
        "source": "https://github.com/MikePageDev/portfolio-frontend"
    },
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "spatie/laravel-package-tools": "^1.9"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "MikePageDev\\PortfolioFrontend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MikePageDev\\PortfolioFrontend\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MikePageDev\\PortfolioFrontend\\PortfolioFrontendServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "lint": "pint --test",
        "check": [
            "@test",
            "@stan",
            "@lint"
        ]
    },
    "minimum-stability": "stable"
}
